<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>North Star Bakery - Contact & Pre-Orders</title>
</head>
<body>
    <header>
        <a href="#main-content">Skip to main content</a>
        <h1>North Star Bakery</h1>
        <nav>
            <ul>
                <li><a href="index.html">Home</a></li>
                <li><a href="products.html">Products</a></li>
                <li><a href="about.html">About Us</a></li>
                <li><a href="contact.html">Contact & Pre-Orders</a></li>
            </ul>
        </nav>
    </header>

    <main id="main-content">
        <h2>Contact Us & Pre-Order Request</h2>
        
        <section>
            <h3>Inquiry and Pre-Order Form</h3>
            <form action="#" method="post">
                <fieldset>
                    <legend>Contact Information</legend>
                    
                    <label for="full-name">Full Name:</label>
                    <input type="text" id="full-name" name="full_name" required><br><br>
                    
                    <label for="email">Email Address:</label>
                    <input type="email" id="email" name="email" required><br><br>
                    
                    <label for="phone">Phone Number:</label>
                    <input type="tel" id="phone" name="phone"><br><br>
                </fieldset>

                <fieldset>
                    <legend>Order Details</legend>
                    
                    <label for="inquiry-type">Inquiry Type:</label>
                    <select id="inquiry-type" name="inquiry_type">
                        <option value="pre-order">Product Pre-Order</option>
                        <option value="catering">Event Catering Inquiry</option>
                        <option value="general">General Question</option>
                    </select><br><br>

                    <label for="pickup-date">Preferred Pickup Date:</label>
                    <input type="date" id="pickup-date" name="pickup_date"><br><br>

                    <label for="message">Details / Items Requested:</label><br>
                    <textarea id="message" name="message" rows="5" cols="40" placeholder="List the products and quantities you wish to pre-order..."></textarea><br><br>
                </fieldset>

                <button type="submit">Submit Request</button>
            </form>
        </section>

        <section>
            <h3>Location & Operating Hours</h3>
            <p><strong>Address:</strong> 123 Main Street, Downtown</p>
            <p><strong>Hours of Operation:</strong></p>
            <ul>
                <li>Tuesday – Friday: 6:00 AM – 4:00 PM</li>
                <li>Saturday – Sunday: 7:00 AM – 3:00 PM</li>
                <li>Monday: Closed</li>
            </ul>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 North Star Bakery. All rights reserved.</p>
    </footer>
</body>
</html>
